{
  "name": "badminton-training-platform",
  "version": "1.0.0",
  "description": "Youth Badminton Training Knowledge Base Platform (4-15 years)",
  "private": true,
  "workspaces": [
    "docs",
    "scripts"
  ],
  "scripts": {
    "docs:dev": "npm run docs:dev --workspace=docs",
    "docs:build": "npm run docs:build --workspace=docs",
    "docs:clean": "npm run docs:clean --workspace=docs",
    "validate": "npm run validate-content --workspace=scripts",
    "generate-images": "npm run generate-images --workspace=scripts",
    "build": "npm run docs:build && npm run build-static --workspace=scripts",
    "deploy": "npm run deploy-cdn --workspace=scripts",
    "install:all": "npm install && npm install --workspace=docs && npm install --workspace=scripts",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "badminton",
    "training",
    "youth-sports",
    "knowledge-base",
    "wechat-miniprogram"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
